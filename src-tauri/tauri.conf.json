{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Faro",
  "version": "0.1.0",
  "identifier": "com.arodr.faro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Faro",
        "width": 576,
        "height": 324,
        "resizable": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Aníbal Rodríguez",
    "copyright": "Copyright © 2026 Aníbal Rodríguez",
    "licenseFile": "../LICENSE",
    "targets": ["nsis", "dmg", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "languages": ["Spanish"],
        "displayLanguageSelector": false,
        "installMode": "perMachine",
        "startMenuFolder": "Faro",
        "installerHooks": "windows/nsis-hooks.nsh"
      }
    }
  }
}
