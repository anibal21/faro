{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-session-purge-ephemeral",
    "allow-prefs-get",
    "allow-prefs-set",
    "allow-env-list",
    "allow-env-upsert",
    "allow-env-delete",
    "allow-env-load",
    "allow-env-set-active",
    "allow-env-workspace-get",
    "allow-env-connect",
    "allow-env-disconnect",
    "allow-demo-fixture-paths",
    "allow-k8s-list-deployments",
    "allow-k8s-list-configmaps",
    "allow-k8s-get-configmap",
    "allow-catalog-refresh",
    "allow-logs-open",
    "allow-logs-close",
    "allow-logs-set-view",
    "allow-analyze-write-group"
  ]
}
